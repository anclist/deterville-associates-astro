---
/** Organism: ApproachRow — how the firm works, as four short columns. Used when the hero carries an image. */
import Container from '@atoms/Container.astro';
import { approach } from '@data/site';
---
<section class="approach" aria-label="How we work">
  <Container>
    <ul>
      {approach.map((a) => (
        <li><strong>{a.title}</strong><span>{a.body}</span></li>
      ))}
    </ul>
  </Container>
</section>

<style>
  .approach { padding-block: var(--space-7); border-block: 1px solid var(--color-border); }
  ul { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-7); }
  li { display: grid; gap: var(--space-2); align-content: start; }
  strong { font: 500 var(--size-1)/1.25 var(--font-heading); color: var(--color-heading); }
  span { font-size: var(--size--1); color: var(--color-text-muted); }
  @media (max-width: 62rem) { ul { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 36rem) { ul { grid-template-columns: 1fr; gap: var(--space-5); } }
</style>
