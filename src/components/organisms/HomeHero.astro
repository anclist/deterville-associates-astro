---
/**
 * Organism: HomeHero — the firm's name and promise beside a visual, in the sister firm's hero layout.
 * `visual="approach"` lists how the firm works; `visual="flag"` puts the Saint Lucia flag in the
 * portrait slot, `visual="pitons"` an illustration of the Pitons, and `visual="photo"` a gavel in
 * front of the flag (a wide image cropped to the slot around the gavel). Pair image visuals with
 * ApproachRow so the approach still appears on the page.
 */
import Container from '@atoms/Container.astro';
import Button from '@atoms/Button.astro';
import Flag from '@atoms/Flag.astro';
import Pitons from '@atoms/Pitons.astro';
import { firm, approach } from '@data/site';

interface Props { visual?: 'approach' | 'flag' | 'pitons' | 'photo' }
const { visual = 'approach' } = Astro.props;
const image = (v: string) => v !== 'approach';
---
<section class:list={['hero', image(visual) ? 'hero--image' : 'hero--approach']} aria-labelledby="hero-title">
  <Container class="hero__grid">
    {visual === 'flag' && <Flag crop="portrait" class="hero__image" />}
    {visual === 'pitons' && <Pitons class="hero__image" />}
    {visual === 'photo' && (
      <img class="hero__image hero__photo" src="/images/hero-gavel-flag.jpg" alt="A judge's gavel in front of the flag of Saint Lucia" width="1536" height="864" fetchpriority="high" />
    )}

    <div class="text">
      <h1 id="hero-title">Deterville &amp; Associates</h1>
      <p class="role">{firm.tagline}</p>
      <p>
        A law firm in Castries, Saint Lucia. We work with families, property owners and businesses, and help people
        with citizenship and immigration, explaining your options in language you can understand.
      </p>
      <div class="actions">
        <Button href={firm.bookHref} size="lg">Book a consultation</Button>
        <a class="alt" href={firm.phoneHref}>or call {firm.phone}</a>
      </div>
      <p class="trust">{firm.address.line1}, {firm.address.city} · Open {firm.hours} · {firm.hoursNote}</p>
    </div>

    {visual === 'approach' && (
      <ul class="approach" aria-label="How we work">
        {approach.map((a) => (
          <li><strong>{a.title}</strong><span>{a.body}</span></li>
        ))}
      </ul>
    )}
  </Container>
</section>

<style>
  .hero { padding-block: var(--space-8); }
  .hero :global(.hero__grid) { display: grid; gap: var(--space-8); align-items: center; }
  .hero--approach :global(.hero__grid) { grid-template-columns: 7fr 5fr; }
  .hero--image :global(.hero__grid) { grid-template-columns: 5fr 7fr; }
  .hero :global(.hero__image) { border-radius: var(--radius-sm); }
  .hero__photo { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; object-position: 74% center; }
  h1 { font-size: var(--size-4); line-height: 1.05; }
  .role { margin-top: var(--space-3); font-size: var(--size-1); color: var(--color-text-muted); }
  .text > p:not(.role) { margin-top: var(--space-5); max-width: 52ch; }
  .text > .trust { font-size: var(--size--1); color: var(--color-text-muted); }
  .actions { display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap; margin-top: var(--space-6); }
  .alt { text-underline-offset: 0.2em; }

  .approach {
    list-style: none; margin: 0; padding: var(--space-6);
    display: grid; gap: var(--space-5);
    background: var(--color-surface-tint); border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-accent);
  }
  .approach li { display: grid; gap: var(--space-1); }
  .approach strong { font: 500 var(--size-1)/1.25 var(--font-heading); color: var(--color-heading); }
  .approach span { font-size: var(--size--1); color: var(--color-text-muted); }

  @media (max-width: 52rem) {
    .hero { padding-top: var(--space-5); }
    .hero--approach :global(.hero__grid), .hero--image :global(.hero__grid) { grid-template-columns: 1fr; gap: var(--space-7); }
    .hero :global(.hero__image) { max-width: 20rem; }
  }
</style>
