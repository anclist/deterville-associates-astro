---
/**
 * Organism: SiteFooter — the one dark surface on a page, so it reads unmistakably as the end.
 * Sister-firm link first, then firm summary, practice groups, firm pages, contact, socials.
 */
import Container from '@atoms/Container.astro';
import { firm, sister, nav, practiceGroups, socials } from '@data/site';

const year = new Date().getFullYear();
const firmLinks = nav.filter((n) => n.href !== '/practice-areas');
---
<footer class="site-footer">
  <Container>
    <section class="sister" aria-label="Sister firm">
      <p>
        Our sister firm in Toronto, <a href={sister.href} target="_blank" rel="noopener">{sister.name}</a>, handles{' '}
        {sister.summary}.
      </p>
    </section>

    <div class="grid">
      <div class="brand">
        <p class="name">{firm.name}</p>
        <p>{firm.tagline}.</p>
        <p>{firm.address.line1}<br />{firm.address.city}</p>
      </div>
      <nav aria-labelledby="footer-practice">
        <h2 id="footer-practice">Practice areas</h2>
        <ul>{practiceGroups.map((g) => <li><a href="/practice-areas">{g.title}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="footer-firm">
        <h2 id="footer-firm">The firm</h2>
        <ul>{firmLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <div>
        <h2>Contact</h2>
        <ul>
          <li><a href={firm.phoneHref}>{firm.phone}</a></li>
          <li><a href={firm.phoneAltHref}>{firm.phoneAlt}</a></li>
          <li><a href={`mailto:${firm.email}`}>{firm.email}</a></li>
          <li>Open {firm.hours}<br />{firm.hoursNote}</li>
        </ul>
      </div>
    </div>

    <div class="bottom">
      <ul class="socials" aria-label="Social media">
        {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ul>
      <p>Mailing address: {firm.mailing}</p>
      <p>Information on this site is general and is not legal advice. Contacting us does not create a lawyer–client relationship.</p>
      <p>© {year} {firm.name} · <a href="/styleguide">Styleguide</a></p>
      <p class="credit">Developed by <a href="https://anclist.com" target="_blank" rel="noopener">anclist web dev</a></p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    background: var(--color-surface-inverse); color: var(--color-text-inverse-muted);
    padding-block: var(--space-8) var(--space-7); font-size: var(--size--1);
    --color-focus: var(--color-text-inverse);
  }
  p, li { color: var(--color-text-inverse-muted); }
  a { color: var(--color-text-inverse); text-decoration: none; overflow-wrap: anywhere; }
  a:hover { text-decoration: underline; }
  h2 { font: 600 var(--size--1)/1.3 var(--font-body); color: var(--color-text-inverse-muted); margin-bottom: var(--space-4); }
  ul { list-style: none; padding: 0; display: grid; gap: var(--space-3); }

  .sister { padding-bottom: var(--space-6); margin-bottom: var(--space-7); border-bottom: 1px solid rgb(255 255 255 / 0.14); }
  .sister p { font-size: var(--size-0); }
  .sister a { text-decoration: underline; text-underline-offset: 0.2em; }

  .grid { display: grid; grid-template-columns: 1.6fr 1fr 1.2fr 1.2fr; gap: var(--space-7); }
  .brand { display: grid; gap: var(--space-3); align-content: start; max-width: 32ch; }
  .name { font: 500 var(--size-2)/1.2 var(--font-heading); color: var(--color-text-inverse); }
  .bottom { margin-top: var(--space-8); padding-top: var(--space-5); border-top: 1px solid rgb(255 255 255 / 0.14); display: grid; gap: var(--space-3); }
  .socials { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); margin-bottom: var(--space-2); }
  .bottom p { font-size: var(--size--2); max-width: 90ch; }

  @media (max-width: 62rem) { .grid { grid-template-columns: 1fr 1fr; } }
  /* Phones: link lists sit two across; the firm summary and contact details take the full width */
  @media (max-width: 36rem) { .grid { gap: var(--space-6) var(--space-5); } .grid > :first-child, .grid > :last-child { grid-column: 1 / -1; } }
  .credit a { text-decoration: underline; text-underline-offset: 0.2em; }
</style>
