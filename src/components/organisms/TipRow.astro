---
/** Organism: TipRow — the latest "Tip of the Week" posts in a row of three. Sibling of QuoteRow. */
import Container from '@atoms/Container.astro';
import SectionHeading from '@molecules/SectionHeading.astro';
import { tips } from '@data/site';

const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<section class="tips" aria-labelledby="tips-title">
  <Container>
    <SectionHeading id="tips-title" title="Tip of the Week" lede="Short notes on Saint Lucia law from the D&A blog." />
    <div class="grid">
      {tips.map((t) => (
        <article>
          <time datetime={t.date}>{fmt(t.date)}</time>
          <h3><a href={`/blog/${t.slug}`}>{t.title}</a></h3>
          <p>{t.excerpt}</p>
        </article>
      ))}
    </div>
    <p class="all"><a href="/blog">Read all tips</a></p>
  </Container>
</section>

<style>
  .tips { padding-block: var(--space-9); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-7); }
  article { display: grid; gap: var(--space-2); align-content: start; }
  time { font-size: var(--size--1); color: var(--color-text-muted); }
  h3 { font-size: var(--size-1); line-height: 1.3; }
  h3 a { color: var(--color-heading); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  article p { font-size: var(--size--1); color: var(--color-text-muted); }
  .all { margin-top: var(--space-6); }
  .all a { text-underline-offset: 0.2em; }
  @media (max-width: 62rem) { .grid { grid-template-columns: 1fr; gap: var(--space-6); } }
</style>
