---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Container from '@atoms/Container.astro';
import PageHero from '@organisms/PageHero.astro';
import PostGrid from '@organisms/PostGrid.astro';
import CtaBand from '@organisms/CtaBand.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Tip of the Week" description="Short notes on Saint Lucia law from Deterville & Associates: property, family, citizenship and practising law.">
  <PageHero title="Tip of the Week" lede="Short notes on Saint Lucia law from the D&A blog. General information, not legal advice." />
  <section class="blog">
    <Container>
      <PostGrid posts={posts} headingLevel="h2" />
    </Container>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  .blog { padding-block: var(--space-7) var(--layout-section); }
</style>
